# 复制此文件为 .env 并填入你的 API Key

# 智谱 GLM API Key（推荐：默认用于中文搜索扩展、AI 摘要/对话和共识证据抽取）
# 获取地址：https://open.bigmodel.cn/
ZHIPUAI_API_KEY=your_zhipu_api_key_here

# 其他模型提供商（可选，可在应用设置页切换）
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Semantic Scholar API Key（可选：配置后加入多源检索）
# SEMANTIC_SCHOLAR_API_KEY=your_s2_api_key_here

# OpenAlex 邮箱（可选：填写后可获得更高 API 调用频率）
# OPENALEX_EMAIL=your_email@example.com
